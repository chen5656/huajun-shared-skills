{
  "$schema": "./autopilot.schema.json",
  "project_id": "example-app",
  "repo_root": ".",
  "app_source": "../example_app/src",
  "knowledge_dir": "knowledge",
  "artifacts_dir": "artifacts",

  "platforms": {
    "ios": {
      "enabled": true,
      "app_id": "com.example.app",
      "manifest": "test-ios/index.json",
      "device": {
        "kind": "simulator",
        "name": "iPhone 17",
        "udid": "00000000-0000-0000-0000-000000000000",
        "known_bad": ["iPhone 17 Pro"]
      },
      "build_command": "npx expo run:ios -d {udid}",
      "dev_server": {
        "port": 8081,
        "start_command": "EXPO_NO_TELEMETRY=1 BROWSER=none npx expo start --dev-client --port 8081",
        "forbidden_env": ["CI"]
      },
      "smoke_flow": "test-ios/setup/preflight-smoke-ios.yaml"
    },
    "android": {
      "enabled": true,
      "app_id": "com.example.app",
      "manifest": "test-android/index.json",
      "device": {
        "kind": "real",
        "serial": "REPLACEME",
        "allow_emulator": false
      },
      "preferred_apk": "release",
      "apk_paths": {
        "release": "../example_app/android/app/build/outputs/apk/release/app-release.apk",
        "debug": "../example_app/android/app/build/outputs/apk/debug/app-debug.apk"
      },
      "build_command": "npx expo run:android --device {serial} --variant {variant}",
      "reverse_ports": [8081],
      "smoke_flow": "test-android/setup/preflight-smoke-android.yaml",
      "restore_connectivity": true
    }
  },

  "workspace": "../example_app",
  "java_home_candidates": ["openjdk@17", "openjdk"],

  "run": {
    "per_flow_timeout_seconds": 600,
    "max_repair_loops": 2,
    "default_status": "active",
    "exclude_tags": ["real_api"]
  },

  "report": {
    "compress_screenshots": true
  },

  "seed": {
    "command": "node scripts/seed.mjs --json --run-id {run_id}",
    "env_prefix": "SEED",
    "required_for_tags": ["needs-record"]
  },

  "coverage": {
    "source_root": "../example_app/src",
    "ignore_globs": ["**/*.test.*", "**/__tests__/**", "**/*.md"],
    "map": [
      { "glob": "src/app/(tabs)/**", "families": ["navigation", "home"] },
      { "glob": "src/components/**", "families": ["components"] }
    ]
  },

  "pr": {
    "enabled": true,
    "branch_prefix": "autopilot/",
    "base": "main",
    "remote": "origin",
    "labels": ["autopilot"]
  }
}
